{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.gov.uk/schemas/eligibility-criteria/v2.0",
  "title": "UK Government Eligibility Criteria Decision Tree Schema",
  "description": "JSON Schema for machine-readable representation of eligibility criteria for any UK government service. Fully abstracted to support any domain without schema changes.",
  "version": "2.0",
  "type": "object",
  "required": ["version", "last_updated", "source", "description", "decision_tree", "constants"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Reference to this JSON Schema"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Specification version number (semantic versioning)"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Date when the eligibility criteria was last updated (YYYY-MM-DD)"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "URL of the official government source"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this document"
    },
    "decision_tree": {
      "type": "object",
      "required": ["root", "nodes"],
      "properties": {
        "root": {
          "$ref": "#/definitions/RootNode"
        },
        "nodes": {
          "type": "object",
          "description": "Map of node ID to node definition",
          "additionalProperties": {
            "$ref": "#/definitions/Node"
          }
        }
      }
    },
    "constants": {
      "type": "object",
      "description": "Domain-specific fixed values used throughout the eligibility criteria",
      "additionalProperties": true
    },
    "validation_rules": {
      "type": "object",
      "description": "Domain-specific business logic rules for complex validations",
      "additionalProperties": true
    },
    "external_references": {
      "type": "object",
      "description": "URLs to external data sources and lists",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "definitions": {
    "RootNode": {
      "type": "object",
      "required": ["id", "type", "description", "next"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the root node"
        },
        "type": {
          "type": "string",
          "enum": ["start"],
          "description": "Node type for root node"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the decision tree purpose"
        },
        "next": {
          "type": "string",
          "description": "ID of the first decision node"
        }
      },
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier matching the node's key in the nodes map"
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean_question",
            "multi_path_check",
            "criteria_check",
            "conditional_check",
            "complex_criteria",
            "routing",
            "outcome"
          ],
          "description": "The type of decision or check this node represents"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "boolean_question"}}
          },
          "then": {
            "$ref": "#/definitions/BooleanQuestionNode"
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "multi_path_check"}}
          },
          "then": {
            "$ref": "#/definitions/MultiPathCheckNode"
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "criteria_check"}}
          },
          "then": {
            "$ref": "#/definitions/CriteriaCheckNode"
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "conditional_check"}}
          },
          "then": {
            "$ref": "#/definitions/ConditionalCheckNode"
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "complex_criteria"}}
          },
          "then": {
            "$ref": "#/definitions/ComplexCriteriaNode"
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "routing"}}
          },
          "then": {
            "$ref": "#/definitions/RoutingNode"
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "outcome"}}
          },
          "then": {
            "$ref": "#/definitions/OutcomeNode"
          }
        }
      ]
    },
    "BooleanQuestionNode": {
      "type": "object",
      "required": ["id", "type", "question", "outcomes"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "boolean_question"},
        "question": {
          "type": "string",
          "description": "The yes/no question to evaluate"
        },
        "help_text": {
          "type": "string",
          "description": "Additional guidance for answering the question"
        },
        "reference": {
          "type": "string",
          "format": "uri",
          "description": "URL to official guidance"
        },
        "outcomes": {
          "type": "object",
          "required": ["yes", "no"],
          "properties": {
            "yes": {
              "type": "string",
              "description": "Node ID to navigate to if answer is yes"
            },
            "no": {
              "type": "string",
              "description": "Node ID to navigate to if answer is no"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "MultiPathCheckNode": {
      "type": "object",
      "required": ["id", "type", "question", "paths", "outcomes"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "multi_path_check"},
        "question": {
          "type": "string",
          "description": "Question about meeting any of multiple criteria"
        },
        "help_text": {"type": "string"},
        "reference": {
          "type": "string",
          "format": "uri"
        },
        "evaluation_logic": {
          "type": "string",
          "description": "Explanation of how paths are evaluated (OR vs AND logic)"
        },
        "paths": {
          "type": "array",
          "description": "Array of alternative paths that satisfy the requirement",
          "items": {
            "$ref": "#/definitions/Path"
          },
          "minItems": 1
        },
        "outcomes": {
          "type": "object",
          "description": "Outcomes based on whether any path is satisfied",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "Path": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this path"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this qualification path"
        },
        "criteria": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of criteria that must be met for this path"
        },
        "requirement": {
          "type": "string",
          "description": "Single requirement statement"
        },
        "reference": {
          "type": "string",
          "format": "uri",
          "description": "URL to official guidance for this path"
        }
      },
      "additionalProperties": true
    },
    "CriteriaCheckNode": {
      "type": "object",
      "required": ["id", "type", "question", "criteria", "outcomes"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "criteria_check"},
        "question": {
          "type": "string",
          "description": "Question about meeting specific measurable criteria"
        },
        "help_text": {"type": "string"},
        "reference": {
          "type": "string",
          "format": "uri"
        },
        "criteria": {
          "type": "object",
          "description": "Domain-specific criteria that must be met",
          "additionalProperties": true
        },
        "outcomes": {
          "type": "object",
          "description": "Outcomes based on criteria check result",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "ConditionalCheckNode": {
      "type": "object",
      "required": ["id", "type", "question", "outcomes"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "conditional_check"},
        "question": {
          "type": "string",
          "description": "Conditional question that may not apply to all applicants"
        },
        "help_text": {"type": "string"},
        "reference": {
          "type": "string",
          "format": "uri"
        },
        "outcomes": {
          "type": "object",
          "description": "Outcomes including 'not applicable' option",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "ComplexCriteriaNode": {
      "type": "object",
      "required": ["id", "type", "question", "outcomes"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "complex_criteria"},
        "question": {
          "type": "string",
          "description": "Question about meeting complex multiple criteria"
        },
        "help_text": {"type": "string"},
        "reference": {
          "type": "string",
          "format": "uri"
        },
        "criteria": {
          "type": "object",
          "description": "Complex criteria that must be met",
          "additionalProperties": true
        },
        "disclaimer": {
          "type": "string",
          "description": "Important disclaimer about discretionary or subjective aspects"
        },
        "common_red_flags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Common indicators that may trigger concerns"
        },
        "outcomes": {
          "type": "object",
          "description": "Outcomes based on whether criteria are met",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "RoutingNode": {
      "type": "object",
      "required": ["id", "type", "description", "outcomes"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "routing"},
        "description": {
          "type": "string",
          "description": "Explanation of routing logic"
        },
        "routing_logic": {
          "type": "string",
          "description": "Detailed explanation of how to determine which path to take"
        },
        "outcomes": {
          "type": "object",
          "description": "Map of routing conditions to target nodes",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "OutcomeNode": {
      "type": "object",
      "required": ["id", "type", "result"],
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "outcome"},
        "result": {
          "type": "string",
          "enum": ["ELIGIBLE", "INELIGIBLE", "DEFERRED"],
          "description": "Final eligibility determination. DEFERRED indicates case requires external decision-making (e.g., HMRC arbitration)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable outcome description"
        },
        "reason": {
          "type": "string",
          "description": "Reason for outcome (for INELIGIBLE and DEFERRED outcomes)"
        },
        "guidance": {
          "type": "string",
          "description": "Next steps or guidance (for INELIGIBLE and DEFERRED outcomes)"
        },
        "next_steps": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of next steps (for ELIGIBLE outcome)"
        },
        "reference": {
          "type": "string",
          "format": "uri",
          "description": "URL to official guidance (optional)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"result": {"const": "ELIGIBLE"}}
          },
          "then": {
            "required": ["description", "next_steps"]
          }
        },
        {
          "if": {
            "properties": {"result": {"const": "INELIGIBLE"}}
          },
          "then": {
            "required": ["reason", "guidance"]
          }
        },
        {
          "if": {
            "properties": {"result": {"const": "DEFERRED"}}
          },
          "then": {
            "required": ["reason", "guidance"],
            "description": "DEFERRED outcomes must explain why external decision is needed"
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
