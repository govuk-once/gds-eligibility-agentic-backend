// UK ../specifications/jobseekers allowance/jobseekers allowance eligibility
digraph {
	rankdir=TB
	node [fontname=Arial fontsize=10]
	edge [fontname=Arial fontsize=9]
	start [label="Start of Jobseeker's Allowance eligibility assessment" fillcolor=lightgreen shape=box style="rounded,filled"]
	start -> check_age
	check_age [label="Is the applicant 18 years old or over and under State Pension age?" fillcolor=lightblue shape=diamond style=filled]
	check_age -> check_location [label=Yes]
	check_age -> INELIGIBLE_age [label=No]
	check_location [label="Is the applicant in Great Britain?" fillcolor=lightblue shape=diamond style=filled]
	check_location -> check_employment_type [label=Yes]
	check_location -> INELIGIBLE_location [label=No]
	check_employment_type [label="Has the applicant worked as an employee (not self-employed)?" fillcolor=lightblue shape=diamond style=filled]
	check_employment_type -> check_ni_contributions [label=Yes]
	check_employment_type -> check_self_employment_exception [label=No]
	check_self_employment_exception [label="Is the applicant a share fisherman or volunteer development worker?" fillcolor=lightblue shape=diamond style=filled]
	check_self_employment_exception -> check_ni_contributions [label=Yes]
	check_self_employment_exception -> INELIGIBLE_self_employed [label=No]
	check_ni_contributions [label="Has the applicant paid or been credited with Class 1 National Insurance contributions in the previous 2 tax years?" fillcolor=orange shape=box style=filled]
	check_ni_contributions -> check_working_hours [label="Meets Criteria"]
	check_ni_contributions -> INELIGIBLE_ni_contributions [label="Does Not Meet"]
	check_working_hours [label="Is the applicant currently working 16 or more hours per week?" fillcolor=lightblue shape=diamond style=filled]
	check_working_hours -> INELIGIBLE_working_hours [label=Yes]
	check_working_hours -> check_trade_dispute [label=No]
	check_trade_dispute [label="Is the applicant currently involved in a trade dispute with their employer?" fillcolor=lightblue shape=diamond style=filled]
	check_trade_dispute -> INELIGIBLE_trade_dispute [label=Yes]
	check_trade_dispute -> check_illness_disability [label=No]
	check_illness_disability [label="Does the applicant have an illness or disability that prevents them from working?" fillcolor=lightblue shape=diamond style=filled]
	check_illness_disability -> INELIGIBLE_illness_disability [label=Yes]
	check_illness_disability -> check_full_time_study [label=No]
	check_full_time_study [label="Is the applicant studying full-time?" fillcolor=lightblue shape=diamond style=filled]
	check_full_time_study -> check_study_eligibility [label=Yes]
	check_full_time_study -> check_available_for_work [label=No]
	check_study_eligibility [label="Does the applicant meet all the requirements for full-time student JSA eligibility?" fillcolor=orange shape=box style=filled]
	check_study_eligibility -> check_available_for_work [label="Meets Criteria"]
	check_study_eligibility -> INELIGIBLE_full_time_study [label="Does Not Meet"]
	check_available_for_work [label="Is the applicant available to start work straight away?" fillcolor=lightblue shape=diamond style=filled]
	check_available_for_work -> check_work_search_commitment [label=Yes]
	check_available_for_work -> INELIGIBLE_not_available [label=No]
	check_work_search_commitment [label="Is the applicant willing to actively look for work and agree to a Claimant Commitment?" fillcolor=lightblue shape=diamond style=filled]
	check_work_search_commitment -> ELIGIBLE [label=Yes]
	check_work_search_commitment -> INELIGIBLE_no_commitment [label=No]
	ELIGIBLE [label="ELIGIBLE\n" fillcolor=green fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_age [label="INELIGIBLE\nThe applicant does not meet the age requirements for Jobseeker's Allowance." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_location [label="INELIGIBLE\nThe applicant is not in Great Britain." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_self_employed [label="INELIGIBLE\nSelf-employed individuals who only paid Class 2 National Insurance are not eligible for JSA." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_ni_contributions [label="INELIGIBLE\nThe applicant does not have sufficient National Insurance contributions in the previous 2 tax years." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_working_hours [label="INELIGIBLE\nThe applicant is working 16 or more hours per week." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_trade_dispute [label="INELIGIBLE\nThe applicant is currently involved in a trade dispute with their employer." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_illness_disability [label="INELIGIBLE\nThe applicant has an illness or disability that prevents them from working." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_full_time_study [label="INELIGIBLE\nThe applicant is studying full-time and does not meet the eligibility requirements for students." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_not_available [label="INELIGIBLE\nThe applicant is not available to start work straight away." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_no_commitment [label="INELIGIBLE\nThe applicant is not willing to actively look for work or sign a Claimant Commitment." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
}
