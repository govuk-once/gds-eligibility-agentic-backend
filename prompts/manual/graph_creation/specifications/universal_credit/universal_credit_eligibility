// UK ../specifications/universal credit/universal credit eligibility
digraph {
	rankdir=TB
	node [fontname=Arial fontsize=10]
	edge [fontname=Arial fontsize=9]
	start [label="UK Universal Credit Eligibility Assessment" fillcolor=lightgreen shape=box style="rounded,filled"]
	start -> check_age_eligibility
	check_age_eligibility [label="Determine age-based eligibility category" fillcolor=lightgray shape=circle style=filled]
	check_age_eligibility -> INELIGIBLE_too_young [label="Under 16"]
	check_age_eligibility -> check_youth_eligibility [label="Age 16 17"]
	check_age_eligibility -> check_uk_residency [label="Age 18 To Pension"]
	check_age_eligibility -> check_partner_under_pension_age [label="Pension Age Or Over"]
	check_youth_eligibility [label="Does the 16-17 year old meet any special circumstances for eligibility?" fillcolor=plum shape=hexagon style=filled]
	check_youth_eligibility -> check_uk_residency [label="Eligible Via Any Path"]
	check_youth_eligibility -> INELIGIBLE_age_16_17_no_circumstances [label="Not Eligible"]
	check_partner_under_pension_age [label="Do you live with a partner who is under State Pension age?" fillcolor=lightblue shape=diamond style=filled]
	check_partner_under_pension_age -> check_uk_residency [label=Yes]
	check_partner_under_pension_age -> INELIGIBLE_pension_age [label=No]
	check_uk_residency [label="Do you live in the UK (England, Scotland, Wales, or Northern Ireland)?" fillcolor=lightblue shape=diamond style=filled]
	check_uk_residency -> check_eu_eea_swiss_status [label=Yes]
	check_uk_residency -> INELIGIBLE_not_uk_resident [label=No]
	check_eu_eea_swiss_status [label="If you are an EU, EEA, or Swiss citizen, do you have settled or pre-settled status under the EU Settlement Scheme?" fillcolor=lightblue shape=diamond style=filled]
	check_eu_eea_swiss_status -> check_capital_limit [label="Yes Or Not Applicable"]
	check_eu_eea_swiss_status -> INELIGIBLE_no_settled_status [label=No]
	check_capital_limit [label="Do you (and your partner if claiming jointly) have £16,000 or less in total savings, capital, and investments?" fillcolor=orange shape=box style=filled]
	check_capital_limit -> check_student_status [label="16000 Or Less"]
	check_capital_limit -> INELIGIBLE_capital_over_16000 [label="Over 16000"]
	check_student_status [label="Determine if student status affects eligibility" fillcolor=lightgray shape=circle style=filled]
	check_student_status -> check_joint_claim_requirement [label="Not A Student"]
	check_student_status -> check_joint_claim_requirement [label="Part Time Available For Work"]
	check_student_status -> check_student_eligibility_exceptions [label="Full Time Student"]
	check_student_eligibility_exceptions [label="As a full-time student, do you meet any of the eligibility exceptions?" fillcolor=plum shape=hexagon style=filled]
	check_student_eligibility_exceptions -> check_joint_claim_requirement [label="Eligible Via Any Path"]
	check_student_eligibility_exceptions -> INELIGIBLE_full_time_student [label="Not Eligible"]
	check_joint_claim_requirement [label="If you live with a partner, are you making a joint claim together?" fillcolor=lightblue shape=diamond style=filled]
	check_joint_claim_requirement -> ELIGIBLE [label="Yes Or Single"]
	check_joint_claim_requirement -> INELIGIBLE_must_claim_jointly [label="No Separate Claims"]
	ELIGIBLE [label="ELIGIBLE\n" fillcolor=green fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_too_young [label="INELIGIBLE\nUnder 16 years old" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_age_16_17_no_circumstances [label="INELIGIBLE\nAge 16-17 without qualifying special circumstances" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_pension_age [label="INELIGIBLE\nAt or above State Pension age without eligible partner under pension age" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_not_uk_resident [label="INELIGIBLE\nNot living in the UK" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_no_settled_status [label="INELIGIBLE\nEU, EEA, or Swiss citizen without settled or pre-settled status" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_capital_over_16000 [label="INELIGIBLE\nTotal capital, savings, and investments exceed £16,000" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_full_time_student [label="INELIGIBLE\nFull-time student without qualifying circumstances" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_must_claim_jointly [label="INELIGIBLE\nLiving with partner but not making a joint claim" fillcolor=red fontcolor=white shape=box style="rounded,filled"]
}
