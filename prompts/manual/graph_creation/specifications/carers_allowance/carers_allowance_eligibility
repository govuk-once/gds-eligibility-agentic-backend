// UK ../specifications/carers allowance/carers allowance eligibility
digraph {
	rankdir=TB
	node [fontname=Arial fontsize=10]
	edge [fontname=Arial fontsize=9]
	start [label="Start of Carer's Allowance eligibility assessment" fillcolor=lightgreen shape=box style="rounded,filled"]
	start -> check_age
	check_age [label="Is the applicant 16 years old or over?" fillcolor=lightblue shape=diamond style=filled]
	check_age -> check_location [label=Yes]
	check_age -> INELIGIBLE_age [label=No]
	check_location [label="Does the applicant normally live in England or Wales (or are they a member of the armed forces living abroad)?" fillcolor=lightblue shape=diamond style=filled]
	check_location -> check_residency_period [label=Yes]
	check_location -> check_eea_or_scotland [label=No]
	check_eea_or_scotland [label="Route applicants based on location (Scotland, EEA, or ineligible)" fillcolor=lightgray shape=circle style=filled]
	check_eea_or_scotland -> INELIGIBLE_scotland [label=Scotland]
	check_eea_or_scotland -> check_eea_settled_status [label=Eea]
	check_eea_or_scotland -> INELIGIBLE_location [label=Other]
	check_eea_settled_status [label="Does the EEA/Swiss applicant have settled or pre-settled status under the EU Settlement Scheme?" fillcolor=lightblue shape=diamond style=filled]
	check_eea_settled_status -> check_residency_period [label=Yes]
	check_eea_settled_status -> INELIGIBLE_eea_status [label=No]
	check_residency_period [label="Has the applicant been in England, Scotland, or Wales for at least 2 of the last 3 years?" fillcolor=lightblue shape=diamond style=filled]
	check_residency_period -> check_immigration_control [label=Yes]
	check_residency_period -> check_refugee_status [label=No]
	check_refugee_status [label="Is the applicant a refugee or do they have humanitarian protection status?" fillcolor=lightblue shape=diamond style=filled]
	check_refugee_status -> check_immigration_control [label=Yes]
	check_refugee_status -> INELIGIBLE_residency_period [label=No]
	check_immigration_control [label="Is the applicant subject to immigration control?" fillcolor=lightblue shape=diamond style=filled]
	check_immigration_control -> INELIGIBLE_immigration_control [label=Yes]
	check_immigration_control -> check_full_time_education [label=No]
	check_full_time_education [label="Is the applicant in full-time education or studying for 21 hours a week or more?" fillcolor=lightblue shape=diamond style=filled]
	check_full_time_education -> INELIGIBLE_full_time_education [label=Yes]
	check_full_time_education -> check_care_hours [label=No]
	check_care_hours [label="Does the applicant spend at least 35 hours a week caring for someone?" fillcolor=lightblue shape=diamond style=filled]
	check_care_hours -> check_person_gets_qualifying_benefit [label=Yes]
	check_care_hours -> INELIGIBLE_insufficient_care_hours [label=No]
	check_person_gets_qualifying_benefit [label="Does the person being cared for receive one of the qualifying disability benefits?" fillcolor=plum shape=hexagon style=filled]
	check_person_gets_qualifying_benefit -> check_shared_care [label="Eligible Via Any Path"]
	check_person_gets_qualifying_benefit -> INELIGIBLE_no_qualifying_benefit [label="Not Eligible"]
	check_shared_care [label="Is another carer already claiming Carer's Allowance, Carer Support Payment, or the Universal Credit extra amount for caring for this same person?" fillcolor=lightblue shape=diamond style=filled]
	check_shared_care -> INELIGIBLE_shared_care [label=Yes]
	check_shared_care -> check_earnings [label=No]
	check_earnings [label="Are the applicant's weekly earnings £196 or less after tax, National Insurance, and allowable expenses?" fillcolor=orange shape=box style=filled]
	check_earnings -> check_state_pension_interaction [label="Meets Requirement"]
	check_earnings -> INELIGIBLE_earnings_too_high [label="Does Not Meet"]
	check_state_pension_interaction [label="Does the applicant receive State Pension?" fillcolor=lightblue shape=diamond style=filled]
	check_state_pension_interaction -> check_state_pension_amount [label=Yes]
	check_state_pension_interaction -> ELIGIBLE [label=No]
	check_state_pension_amount [label="Determine Carer's Allowance payment based on State Pension amount" fillcolor=lightgray shape=circle style=filled]
	check_state_pension_amount -> ELIGIBLE_no_payment_pension_credit [label="Pension 83 30 Or More"]
	check_state_pension_amount -> ELIGIBLE_top_up_payment [label="Pension Less Than 83 30"]
	ELIGIBLE [label="ELIGIBLE\n" fillcolor=green fontcolor=white shape=box style="rounded,filled"]
	ELIGIBLE_top_up_payment [label="ELIGIBLE\n" fillcolor=green fontcolor=white shape=box style="rounded,filled"]
	ELIGIBLE_no_payment_pension_credit [label="ELIGIBLE\n" fillcolor=green fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_age [label="INELIGIBLE\nThe applicant is under 16 years old." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_scotland [label="INELIGIBLE\nThe applicant lives in Scotland." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_location [label="INELIGIBLE\nThe applicant does not live in an eligible location." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_eea_status [label="INELIGIBLE\nThe EEA/Swiss applicant does not have settled or pre-settled status under the EU Settlement Scheme." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_residency_period [label="INELIGIBLE\nThe applicant has not been in England, Scotland, or Wales for at least 2 of the last 3 years." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_immigration_control [label="INELIGIBLE\nThe applicant is subject to immigration control." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_full_time_education [label="INELIGIBLE\nThe applicant is in full-time education or studying 21 hours or more per week." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_insufficient_care_hours [label="INELIGIBLE\nThe applicant does not spend at least 35 hours per week caring for someone." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_no_qualifying_benefit [label="INELIGIBLE\nThe person being cared for does not receive a qualifying disability benefit." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_shared_care [label="INELIGIBLE\nAnother carer is already claiming Carer's Allowance, Carer Support Payment, or Universal Credit extra caring amount for the same person." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
	INELIGIBLE_earnings_too_high [label="INELIGIBLE\nThe applicant's weekly earnings exceed £196 after tax, National Insurance, and allowable expenses." fillcolor=red fontcolor=white shape=box style="rounded,filled"]
}
